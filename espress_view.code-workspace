{
	"folders": [
		{
			"name": "application",
			"path": "."
		}
	],
	"settings": {
		"actionButtons": {
			"defaultColor": "Dark Gray",
			"loadNpmCommands": true,
			"commands": [
				{
					"tooltip": "Build",
					"name": "$(build)",
					"color": "#81A1C1", /* Nord Ice Blue — cool and calming */
					"singleInstance": true,
					"terminalName": "Build-Clean",
					"command": "python scripts\\build.py build --entry src\\espress_view\\__main__.py --name espress_view --paths src --add-data assets=assets --collect-data esptool --icon assets\\icons\\exe-file.ico --metadata metadata.yaml",
					"cwd": "${workspaceFolder}"
				},
				{
					"tooltip": "Clean build outputs",
					"name": "$(clear-all)",
					"color": "#D08770", /* Muted Terracotta — soft burnt orange */
					"singleInstance": true,
					"terminalName": "Build-Clean",
					"command": "python scripts\\build.py clean",
					"cwd": "${workspaceFolder}"
				}
			],
		}
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Python Debugger",
				"type": "debugpy",
				"request": "launch",
				"module": "espress_view",
				"console": "integratedTerminal"
			}
		]
	}
}